# Server
PORT=4000
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Postgres (matches docker-compose.yml in the repo root)
DATABASE_URL=postgresql://kanban:kanban@localhost:5432/kanban?schema=public

# Failure simulation: probability (0..1) that a write request fails with 503
FAIL_RATE=0.1
# Which HTTP methods may fail (comma-separated)
FAIL_METHODS=POST,PATCH,DELETE
# Artificial latency in ms added to every API request (makes optimistic UI visible)
LATENCY_MS=300
