# Server
PORT=4000
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# Postgres (matches docker-compose.yml in the repo root)
DATABASE_URL=postgresql://kanban:kanban@localhost:5432/kanban?schema=public

# Failure simulation: probability (0..1) that a write request fails with 503
FAIL_RATE=0.1
# Which HTTP methods may fail (comma-separated)
FAIL_METHODS=POST,PATCH,DELETE
# Artificial latency in ms added to every API request (makes optimistic UI visible)
LATENCY_MS=300

# --- Realtime / deployment (optional) ---
# End each SSE stream after N ms (0 = never). Defaults to 55000 on Vercel; the browser reconnects seamlessly.
# SSE_MAX_MS=0
# Fallback poll interval for new events when LISTEN/NOTIFY is unavailable
# EVENT_POLL_MS=2000
# Max DB connections per server instance (small managed Postgres plans have low limits)
# DB_POOL_SIZE=5
# Optional CA certificate (PEM, newlines as \n) to verify the database TLS certificate
# DATABASE_CA_CERT=
